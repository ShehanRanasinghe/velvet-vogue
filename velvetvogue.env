# SMTP Configuration to Secure Sensitive Data in .env File  #Make sure not space between = mark
SMTP_HOST=#Add your host type like smtp.emailprovidername.com example: smtp.outlook.com
SMTP_PORT=#Add your port number
SMTP_USERNAME=#Add your email address
SMTP_PASSWORD=#Add your email app password (to create this you have to enable 2FA in your account)
SMTP_FROM_NAME=#Add your Website name in '' marks
SMTP_FROM_EMAIL=#Add your email address
RECIPIENT_EMAIL=#Add your email address

#Database Configuration
DB_HOST=#Add Database Hostname
DB_USER=#Add Database UserName
DB_PASS=#Add Database Password
DB_NAME=#Add Database Name

#Make sure add your details to this file.
